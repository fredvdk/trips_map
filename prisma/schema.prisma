generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Trip {
  id            String    @id(map: "trips_map_pkey") @default(uuid())
  destination   String?
  from          DateTime? @db.Timestamptz(6)
  till          DateTime? @db.Timestamptz(6)
  hotel         String?
  hotelCost     String?
  transportMode String?
  transportCost String?
  latitude      Float?
  longitude     Float?
  status        Status?
  notes         String?
  state         String?
  created       DateTime? @db.Timestamptz(6)
  updated       DateTime  @default(now()) @updatedAt @db.Timestamp(6)
}

enum Status {
  Scheduled
  Completed
}
