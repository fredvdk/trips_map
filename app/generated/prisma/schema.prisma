generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma" 
}

datasource db {
  provider = "postgresql"  // Use "postgresql" instead of "postgres"
  url      = env("DATABASE_URL")
}

enum Status {
  Completed
  Scheduled
}

model Trip {
  id            String    @id @default(uuid())  // Auto-generate UUIDs
  destination   String
  from          DateTime?
  till          DateTime?
  hotel         String?   @default("N/A")
  hotelCost     Decimal   @default(0.00) @db.Decimal(10, 2)  // Increased precision
  transportMode String?   @default("Unknown")
  transportCost Decimal   @default(0.00) @db.Decimal(10, 2)
  latitude      Decimal?  @db.Decimal(10, 7)  // Better precision for coordinates
  longitude     Decimal?  @db.Decimal(10, 7)
  status        Status    @default(Scheduled)
  createdAt     DateTime  @default(now())      // Good practice
  updatedAt     DateTime  @updatedAt           // Auto-update timestamps
  
  @@map("trips")  // Optional: use snake_case table name
}